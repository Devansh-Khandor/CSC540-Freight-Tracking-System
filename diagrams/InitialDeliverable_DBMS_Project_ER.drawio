        <mxCell id="business_rules" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;" value="&lt;b&gt;BUSINESS RULES&lt;/b&gt;&lt;br&gt;• ACCOUNT specialization is complete and disjoint.&lt;br&gt;• role ∈ {SHIPPER, CARRIER, VIEWER}.&lt;br&gt;• A lane&#39;s origin and destination hubs must be different.&lt;br&gt;• Booking cannot cause booked shipment weight to exceed DEPARTURE.max_total_weight_kg.&lt;br&gt;• Scan timestamps for a shipment cannot move backward.&lt;br&gt;• Shipment status cannot regress.&lt;br&gt;• current_status is maintained from scan events.&lt;br&gt;• delivery_outcome becomes ON_TIME or LATE after delivery.&lt;br&gt;• scan_sequence is unique only within its shipment." vertex="1">
          <mxGeometry height="285" width="780" x="40" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="vehicle_specialization_note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" value="Vehicle specialization: disjoint; completeness not specified." vertex="1">
          <mxGeometry height="45" width="420" x="460" y="1150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
