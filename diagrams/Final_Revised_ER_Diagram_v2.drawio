          <mxPoint x="900" y="550" />
          <mxPoint x="900" y="967.5" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="has_scan" edge="1" parent="1" source="shipment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=18;strokeWidth=2;startSize=14;endSize=14;labelBackgroundColor=default;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="scan_event" value="◆ HasScan">
      <mxGeometry relative="1" x="0.46" as="geometry">
        <mxPoint y="-18" as="offset" />
        <Array as="points">
          <mxPoint x="970" y="430" />
          <mxPoint x="970" y="530" />
          <mxPoint x="1165" y="530" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="occurs_at" edge="1" parent="1" source="scan_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=18;strokeWidth=2;startSize=14;endSize=14;labelBackgroundColor=default;jumpStyle=arc;jumpSize=10;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="hub" value="OccursAt">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="-55" as="offset" />
        <Array as="points">
          <mxPoint x="1540" y="675" />
          <mxPoint x="1540" y="137.5" />
