# Copy to .env and fill in your assigned schema and credentials.
# Existing exported environment variables take precedence over .env.
DB_HOST=classdb2.csc.ncsu.edu
DB_PORT=3306
DB_NAME=
DB_USER=
# Quote values containing spaces or #. Values are not interpolated.
DB_PASSWORD=

# Flask session signing key. Generate locally; never commit the value.
# At least 32 random characters. Authentication is unavailable without it.
SECRET_KEY=

# Set production only when serving exclusively over HTTPS (enables Secure cookies).
APP_ENV=development
