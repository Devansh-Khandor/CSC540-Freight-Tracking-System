# Copy to .env and fill in your assigned schema and credentials privately.
# Existing exported environment variables take precedence over .env.
# Do not source .env as shell code; python-dotenv interpolation is disabled.
DB_HOST=classdb2.csc.ncsu.edu
DB_PORT=3306
DB_NAME=
DB_USER=
# Quote values containing spaces or #. Never commit a real password.
DB_PASSWORD=

# Flask session signing key: generate locally; never commit its value.
# At least 32 random characters. Authentication is unavailable without it.
SECRET_KEY=

# Local HTTP development. Use production only with HTTPS (Secure cookies).
APP_ENV=development

# Live analytics validation only; offline suites do not need these settings.
# Must exactly match DB_NAME. Use a separately approved dedicated schema for
# isolated mode. Blank schema deliberately prevents accidental validation.
ANALYTICS_TEST_SCHEMA=
ANALYTICS_TEST_MODE=isolated
# Only explicit combined validation on dkhando uses this value: dkhando.
# Leave blank otherwise. This is not approval to load sample data.
ANALYTICS_ALLOW_COMBINED=
